# Supabase (local defaults; replace with `supabase status` output)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres — pooled (transaction-mode, prepare:false) connection for the app runtime.
# The Vercel↔Supabase integration injects this in preview/prod; set by hand only for local dev.
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct (non-pooling) connection for DDL/migrations. Integration-injected; falls back to POSTGRES_URL.
POSTGRES_URL_NON_POOLING=

# Build-time only. Set to `1` in the deploy that serves real users to strip
# `data-testid` from the output. Leave unset everywhere e2e runs — Playwright
# selects on those attributes, including against a production build. See ADR-0014.
STRIP_TEST_IDS=

# Agentic — Supabase MCP (optional, for remote project)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
