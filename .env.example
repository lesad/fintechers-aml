# Postgres — the app runtime connection. Local: the `compose.yaml` container (`pnpm db:start`).
# Deployed: the AWS (RDS) endpoint, set in the Vercel project env.
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Direct connection for DDL/migrations, when POSTGRES_URL goes through a proxy. Falls back to POSTGRES_URL.
POSTGRES_URL_NON_POOLING=

# Build-time only. Set to `1` in the deploy that serves real users to strip
# `data-testid` from the output. Leave unset wherever tests select on those
# attributes. See ADR-0014.
STRIP_TEST_IDS=
