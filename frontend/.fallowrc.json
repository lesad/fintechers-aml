{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/app/main.tsx",
    "vite.config.ts",
    "src/core/test/setup.ts",
    "src/features/*/index.ts",
    "src/core/*/index.ts"
  ],
  "ignorePatterns": ["**/*.generated.ts", "dist/**"],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "circular-dependencies": "error"
  },
  "health": {
    "ignore": ["*.config.ts", "src/core/test/**"]
  },
  "ignoreDependencies": ["@hookform/resolvers", "react-hook-form", "react-dom", "zod"],
  "duplicates": {
    "minTokens": 50,
    "minLines": 5,
    "ignore": ["src/app/globals.css"]
  }
}
