{
  "name": "fintechers-aml",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:changed": "vitest run --changed --project=unit",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm format:check",
    "check:dead": "fallow dead-code",
    "check:dupes": "fallow dupes --mode semantic",
    "check:health": "fallow health",
    "check:fallow": "fallow",
    "check:fallow:fix": "fallow fix --dry-run",
    "data:pull": "bash ../scripts/pull-data.sh",
    "setup:agentic": "cd .. && tsx scripts/setup-skills.ts",
    "freeze": "bash ../scripts/freeze.sh"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@hookform/resolvers": "5.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.14.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.75.0",
    "shadcn": "4.6.0",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.2.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "babel-plugin-react-compiler": "1.0.0",
    "fallow": "2.104.0",
    "happy-dom": "20.9.0",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "tailwindcss": "4.2.4",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.30.2"
}
