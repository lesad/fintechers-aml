{
  "name": "fintechers-aml",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:changed": "vitest run --changed --project=unit",
    "test:integration": "vitest run --project=integration --passWithNoTests",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm format:check",
    "check:full": "pnpm check && pnpm test:integration",
    "check:dead": "fallow dead-code",
    "check:dupes": "fallow dupes --mode semantic",
    "check:health": "fallow health",
    "check:fallow": "fallow",
    "check:fallow:fix": "fallow fix --dry-run",
    "db:start": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:reset": "docker compose down -v db && docker compose up -d --wait db && pnpm db:migrate && pnpm db:seed",
    "db:gen": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "data:pull": "bash scripts/pull-data.sh",
    "setup:agentic": "tsx scripts/setup-skills.ts",
    "ship": "bash scripts/ship.sh",
    "freeze": "bash scripts/freeze.sh"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@hookform/resolvers": "5.2.2",
    "@t3-oss/env-nextjs": "0.13.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.14.0",
    "next": "16.2.4",
    "next-intl": "4.11.0",
    "postgres": "3.4.9",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.75.0",
    "shadcn": "4.6.0",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@swc/plugin-react-remove-properties": "12.6.0",
    "@tailwindcss/postcss": "4.2.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "fallow": "2.104.0",
    "happy-dom": "20.9.0",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "tailwindcss": "4.2.4",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.30.2"
}
