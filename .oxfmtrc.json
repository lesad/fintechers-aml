{
  "ignorePatterns": [".claude/**", "docs/**/*.html", "docs/design/**"],
  "sortImports": {
    "order": "asc",
    "ignoreCase": true,
    "newlinesBetween": true,
    "groups": [
      ["builtin", "external"],
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "type",
      "unknown"
    ]
  }
}
