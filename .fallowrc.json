{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/app/main.tsx",
    "scripts/**/*.ts",
    "vite.config.ts",
    "src/core/test/setup.ts",
    "src/features/*/index.ts",
    "src/core/*/index.ts"
  ],
  "ignorePatterns": ["**/*.generated.ts", "src/components/ui/**", "dist/**"],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "circular-dependencies": "error"
  },
  "health": {
    "ignore": ["*.config.ts", "scripts/**", "src/core/test/**"]
  },
  "ignoreDependencies": [
    "@base-ui/react",
    "@hookform/resolvers",
    "class-variance-authority",
    "lucide-react",
    "react-hook-form",
    "react-dom",
    "zod",
    "shadcn",
    "tw-animate-css"
  ],
  "duplicates": {
    "minTokens": 50,
    "minLines": 5,
    "ignore": ["src/app/globals.css"]
  }
}
